PORT=5000
NODE_ENV=development

# ==============================================================================
# MONGODB CONNECTION STRING
# ==============================================================================
# Paste your MongoDB Atlas URI below:
# e.g.: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/car_rental_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/car_rental_db

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_ACCESS_SECRET=car_rental_jwt_access_secret_super_secure_key_123456
JWT_REFRESH_SECRET=car_rental_jwt_refresh_secret_super_secure_key_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# CORS WHITELIST (comma separated)
# ==============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
